# Node
TZ=UTC
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info

# Generate with: node ace generate:key
APP_KEY=

# Database: set DATABASE_URL (Render provides one) OR the DB_* variables.
# DATABASE_URL=postgresql://user:password@host:5432/carnet
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=carnet
# Enable TLS to the database (required by most managed Postgres, e.g. Render external URL)
DB_SSL=false

# Password for POST /api/auth/login (single admin account)
ADMIN_PASSWORD=change-me

# Comma-separated list of allowed origins; `*` is for local development only
CORS_ORIGIN=http://localhost:5173

# Docker entrypoint only: seed the 5 demo entries when the entries table is empty
SEED_ON_BOOT=false
LIMITER_STORE=database