# Copy to .env next to docker-compose.prod.yml on the VPS.

# Image tag: "latest", or "sha-<7 chars>" pushed by CI.
CARNET_VERSION=latest

# Public domains routed by Traefik
CARNET_DOMAIN=carnet.example.com
CARNET_API_DOMAIN=api.carnet.example.com

# Postgres
DB_USER=carnet
DB_PASSWORD=change-me
DB_NAME=carnet

# API
# Generate with: openssl rand -base64 32
APP_KEY=change-me
ADMIN_PASSWORD=change-me
LOG_LEVEL=info
# "true" seeds the 5 mockup entries once if the table is empty
SEED_ON_BOOT=false
